<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Loading from disk and JSON live here, outside the core: Unity builds the map in memory and does not
         need System.Text.Json (which IL2CPP stripping tends to break). -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Marps.Engine.Data</RootNamespace>
    <Description>Marps data loaders: processed terrain files, mission.json / hazards.json, and the JSON contract options.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Marps.Engine\Marps.Engine.csproj" />
  </ItemGroup>
</Project>
